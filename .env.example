# Скопируйте в .env и заполните. Файл .env не коммитится.

# --- PostgreSQL ---
POSTGRES_USER=archive
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=archive
# Для docker compose хост — db; для локального запуска — localhost
DATABASE_URL=postgresql+asyncpg://archive:change-me-strong-password@db:5432/archive
# База для pytest (будет пересоздаваться!)
TEST_DATABASE_URL=postgresql+asyncpg://archive:change-me-strong-password@db:5432/archive_test

# --- Безопасность ---
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Автовыход из админки по неактивности (минуты)
SESSION_IDLE_MINUTES=30
# true за HTTPS (Caddy); false только для локального http-разработческого режима
COOKIE_SECURE=true
# Попыток входа в минуту с одного IP
LOGIN_RATE_LIMIT=5/minute

# --- Сайт ---
SITE_URL=https://localhost
STORAGE_DIR=/data/storage
MAX_UPLOAD_MB=50

# --- ИИ ---
# auto | anthropic | ollama | rule   (auto: anthropic при наличии ключа, иначе rule)
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
LLM_TIMEOUT_SECONDS=45
# Бесплатные модели OpenRouter (auto выбирает его, если ключ задан, а ключа Anthropic нет)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Распознавание голоса в ИИ-помощнике (Groq Whisper, бесплатно); без ключа — распознавание браузера
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
# Озвучка ответов: edge — бесплатные нейроголоса Microsoft Edge (без ключа), off — голос браузера
TTS_PROVIDER=edge
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# --- OCR ---
TESSERACT_CMD=tesseract
OCR_LANGS=rus+kaz+eng
